{
  "dataset": "hc3",
  "seed": 2025,
  "device": "cpu",
  "threads": 2,
  "source_train": "data/original_text/benchmarks/hc3/hc3_train.json",
  "source_validation": "data/original_text/benchmarks/hc3/hc3_val.json",
  "overlap_policy": "quarantine_train",
  "train_limit": null,
  "validation_limit": null,
  "parser": "en_core_web_sm",
  "roberta": "output/pearl/roberta-base",
  "local_files_only": true,
  "baseline_checkpoint": "model/hc3_gcn_model_2025.pth",
  "prepared": "output/pearl/hc3_seed2025/prepared",
  "edge_output": "output/pearl/hc3_seed2025/edge",
  "gcn_output": "output/pearl/hc3_seed2025/gcn",
  "families": ["synonym", "replace", "insert", "repeat", "delete"],
  "ratios": [0.1],
  "edge_hidden": 64,
  "edge_lr": 0.001,
  "edge_epochs": 20,
  "edge_batch_docs": 8,
  "shuffle_control": false,
  "gcn_lr": 0.0001,
  "weight_decay": 0.00001,
  "gcn_epochs": 10,
  "gcn_batch_docs": 8,
  "epsilon": 0.8,
  "lambda_edge": 0.1,
  "data_root": "data"
}
